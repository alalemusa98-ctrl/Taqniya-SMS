{
  "info": {
    "name": "Phase 02-A: الهيكل الأكاديمي (Academic Structure A)",
    "description": "توثيق واختبارات شاملة ومكتملة لجميع مسارات المرحلة 02-A (13 مساراً) وفق العقد المعماري الرسمي `MD/phases/phase_02_academic_structure_a/routes.md` وقواعد إطار عمل تقنية (Taqniya Framework).\n\nالمجموعات المشمولة:\n0. المصادقة وإعداد الجلسة (auth)\n1. إدارة السنوات الدراسية (academic_years)\n2. كتالوج الفترات المرجعي (academic_terms)\n3. إدارة المراحل التعليمية (academic_stages)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. المصادقة وإعداد الجلسة (Authentication & Setup)",
      "description": "تسجيل دخول مدير النظام للحصول على توكن الصلاحية وتخزينه تلقائياً في authToken لتشغيل الاختبارات.",
      "item": [
        {
          "name": "تسجيل الدخول كمدير النظام (Login as Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "تسجيل دخول مدير النظام والحصول على التوكن وحفظه في متغير البيئة `authToken` لتمريره في جميع المسارات التالية.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_code\": \"{{adminUserCode}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - تم تسجيل الدخول بنجاح\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Login response contains valid bearer token\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.token).to.be.a('string');",
                  "    });",
                  "    ",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.environment.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"✅ تم حفظ authToken بنجاح لاختبارات المرحلة 02-A.\");",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "1. إدارة السنوات الدراسية (Academic Years)",
      "description": "مسارات إدارة السنوات الدراسية (استعراض، إنشاء، تعديل، تفعيل ذري، وحذف).",
      "item": [
        {
          "name": "1.1 استعراض وبحث قائمة السنوات الدراسية (List Academic Years)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/years?search=&is_active=&sort_by=id&sort_order=desc&page=1&per_page=15",
            "description": "استرجاع قائمة كافة السنوات الدراسية المسجلة بالمنظومة مع دعم البحث النصي والفلترة والتنقل والفرز.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - نجاح جلب قائمة السنوات الدراسية\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response has valid academic years schema\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.meta).to.be.an('object');",
                  "    pm.expect(jsonData.meta.current_page).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "response": []
