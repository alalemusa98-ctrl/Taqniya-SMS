{
  "info": {
    "name": "Phase 02-C: فترات الصفوف وتسكين الشعب والمناهج (Class Terms, Sections & Curriculum)",
    "description": "توثيق واختبارات شاملة ومكتملة لجميع مسارات المرحلة 02-C (13 مساراً) وفق العقد المعماري الرسمي `MD/phases/phase_02_academic_structure_c/routes.md` وقواعد إطار عمل تقنية (Taqniya Framework).\n\nالمجموعات المشمولة:\n0. المصادقة وإعداد الجلسة (Authentication & Setup)\n1. إدارة فترات وحالات الصفوف (Class Academic Terms)\n2. إدارة ربط وتسكين الشعب بالصفوف (Class Sections)\n3. إدارة مناهج الصفوف والدرجات لكل فترة (Class Subjects & Curriculum)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. المصادقة وإعداد الجلسة (Authentication & Setup)",
      "description": "تهيئة الجلسة وتسجيل دخول مدير النظام لاستخراج التوكن وحفظه في متغير البيئة `authToken`.",
      "item": [
        {
          "name": "تسجيل الدخول كمدير النظام (Login as Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "تسجيل دخول مدير النظام والحصول على التوكن وحفظه في متغير البيئة `authToken` لتمريره في جميع مسارات المرحلة 02-C.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_code\": \"{{adminUserCode}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - تم تسجيل الدخول بنجاح\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Login response contains valid bearer token\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.token).to.be.a('string');",
                  "    });",
                  "    ",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.environment.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"✅ تم حفظ authToken بنجاح لاختبارات المرحلة 02-C.\");",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "1. إدارة فترات وحالات الصفوف (Class Academic Terms)",
      "description": "مسارات إدارة وتخصيص الفترات الدراسية للصفوف، تفعيل الفترة النشطة ذرياً (Atomic Activation)، وإغلاق/فتح درجات الفترات للأرشفة وفك الربط.",
      "item": [
        {
          "name": "1.1 عرض وبحث فترات وحالات الصفوف (List Class Academic Terms)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-academic-terms?class_id=&academic_term_id=&is_active=&is_closed=&search=&page=1&per_page=15",
            "description": "استرجاع فترات وحالات كافة صفوف المدرسة مجمعة هرمياً لكل صف مع دعم الفلترة لصف محدد أو فترة محددة أو البحث النصي والترقيم القياسي.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - نجاح جلب فترات وحالات صفوف المدرسة\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response contains structured classes and terms schema\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "    pm.expect(jsonData.data.classes).to.be.an('array');",
                  "    pm.expect(jsonData.meta).to.be.an('object');",
                  "    pm.expect(jsonData.meta.current_page).to.be.a('number');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.classes.length > 0) {",
                  "    for (var i = 0; i < jsonData.data.classes.length; i++) {",
                  "        var c = jsonData.data.classes[i];",
                  "        if (c.terms && c.terms.length > 0) {",
                  "            pm.environment.set(\"testClassTermId\", c.terms[0].id);",
                  "            pm.environment.set(\"testClassId\", c.class_id);",
                  "            break;",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "1.2 تخصيص وربط فترة بصف دراسي (Assign Class Academic Term)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-academic-terms",
            "description": "تخصيص وربط فترة رسمية لصف دراسي في القالب العام بحالة افتراضية (is_active = 0, is_closed = 0) مع فحص عدم التكرار (uq_class_term).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_id\": {{testClassId}},\n  \"academic_term_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created or 409 Conflict\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Response contains assigned class term details\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.id).to.be.a('number');",
                  "        pm.expect(jsonData.data.is_active).to.eql(0);",
                  "        pm.expect(jsonData.data.is_closed).to.eql(0);",
                  "    });",
                  "    pm.environment.set(\"testClassTermId\", jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "1.3 تعديل فترة صف دراسي (Update Class Academic Term)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-academic-terms/{{testClassTermId}}",
            "description": "تحديث فترة الصف المخصصة مع فحص حالة الإغلاق للأرشفة (منع التعديل إذا كانت is_closed = 1).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_id\": {{testClassId}},\n  \"academic_term_id\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK or 409 Conflict\", function () {",
                  "    pm.expect([200, 404, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Response confirms class term update\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.id).to.eql(Number(pm.environment.get(\"testClassTermId\")));",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "1.4 تفعيل الفترة النشطة للصف ذرياً (Activate Class Academic Term)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-academic-terms/{{testClassTermId}}/activate",
            "description": "تحويل الفترة المستهدفة إلى الفترة النشطة الحصرية للصف (is_active = 1) وإلغاء تفعيل بقية فترات نفس الصف ذرياً داخل Atomic Transaction.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK - تم تفعيل الفترة النشطة بنجاح\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response indicates is_active is 1\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.is_active).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "1.5 إغلاق أو فتح درجات الفترة للصف (Toggle Close Class Academic Term)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-academic-terms/{{testClassTermId}}/close",
            "description": "تبديل حالة إغلاق درجات الفترة للصف (is_closed: 1 / 0) للأرشفة ومنع التعديل على درجات المواد.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK - تم تغيير حالة إغلاق الفترة بنجاح\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response contains updated is_closed state\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.is_closed).to.be.oneOf([0, 1]);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "1.6 فك ربط فترة غير نشطة من صف دراسي (Delete Class Academic Term)",
