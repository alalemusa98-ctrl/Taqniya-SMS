            "description": "إلغاء تخصيص فترة لصف دراسي بشرط ألا تكون الفترة النشطة حالياً للصف وألا تحتوي على مواد دراسية مسندة (ON DELETE RESTRICT).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK or 409 Conflict (RESTRICT)\", function () {",
                  "    pm.expect([200, 404, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Response confirms class term removal\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
