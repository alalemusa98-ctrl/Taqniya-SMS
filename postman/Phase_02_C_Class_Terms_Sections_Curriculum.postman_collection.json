    {
      "name": "3. إدارة مناهج الصفوف والدرجات لكل فترة (Class Subjects & Curriculum)",
      "description": "مسارات استعراض المناهج موزعة بالفصول، إسناد المواد وتحديد درجات النجاح والعظمى (passing_score <= max_score)، تعديل درجات المواد مع حظر التعديل بالفترات المغلقة، وحذف المواد مع حظر الحذف عند وجود درجات مسجلة (RESTRICT).",
      "item": [
        {
          "name": "3.1 استعراض مناهج ومقررات الصفوف بالفصول (List Class Subjects)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-subjects?class_id=&class_academic_term_id=&search=&page=1&per_page=15",
            "description": "استرجاع الهيكل الكامل لمناهج ومقررات صفوف المدرسة موزعة بحسب الفصول الدراسية مع تفاصيل المواد ودرجات النجاح والدرجة العظمى لكل فصل والترقيم القياسي.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - نجاح جلب مناهج ومقررات الصفوف\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response contains structured classes, terms and subjects schema\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "    pm.expect(jsonData.data.classes).to.be.an('array');",
                  "    pm.expect(jsonData.meta).to.be.an('object');",
                  "    pm.expect(jsonData.meta.current_page).to.be.a('number');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.classes.length > 0) {",
                  "    for (var i = 0; i < jsonData.data.classes.length; i++) {",
                  "        var c = jsonData.data.classes[i];",
                  "        if (c.terms && c.terms.length > 0) {",
                  "            for (var j = 0; j < c.terms.length; j++) {",
                  "                var t = c.terms[j];",
                  "                if (t.subjects && t.subjects.length > 0) {",
                  "                    pm.environment.set(\"testClassSubjectId\", t.subjects[0].id);",
                  "                    pm.environment.set(\"testSubjectId\", t.subjects[0].subject_id);",
                  "                    break;",
                  "                }",
                  "            }",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "3.2 إسناد مادة وتحديد درجات الفترة (Assign Class Subject)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-subjects",
            "description": "إضافة مادة لمنهج فترة محددة بالصف وتعيين درجة النجاح والدرجة العظمى مع التحقق من قيد النزاهة (passing_score <= max_score) وتفرد المادة بالفترة (uq_class_term_subject).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_academic_term_id\": {{testClassTermId}},\n  \"subject_id\": 1,\n  \"passing_score\": 50.00,\n  \"max_score\": 100.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created or 409 Conflict\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Response contains assigned subject details with scores\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.id).to.be.a('number');",
                  "        pm.expect(jsonData.data.passing_score).to.eql(\"50.00\");",
                  "        pm.expect(jsonData.data.max_score).to.eql(\"100.00\");",
                  "    });",
                  "    pm.environment.set(\"testClassSubjectId\", jsonData.data.id);",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "3.3 تعديل درجات مادة مسندة بالفترة (Update Class Subject)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-subjects/{{testClassSubjectId}}",
            "description": "تحديث بيانات ودرجات مادة مسندة بفترة صف مع التحقق من عدم إغلاق الفترة للأرشفة (is_closed = 0) وقيد النزاهة (passing_score <= max_score).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"class_academic_term_id\": {{testClassTermId}},\n  \"subject_id\": 1,\n  \"passing_score\": 60.00,\n  \"max_score\": 100.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK or 409 Conflict\", function () {",
                  "    pm.expect([200, 404, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Response confirms subject score update\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.passing_score).to.eql(\"60.00\");",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "3.4 إزالة مادة من منهج فترة الصف (Delete Class Subject)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/class-subjects/{{testClassSubjectId}}",
            "description": "حذف مادة من مقررات فترة الصف بشرط عدم وجود درجات امتحانات مسجلة أو جدول حصص مسجل لها (ON DELETE RESTRICT -> 409 Conflict).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK or 409 Conflict (RESTRICT)\", function () {",
                  "    pm.expect([200, 404, 409]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Response confirms class subject removal\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}