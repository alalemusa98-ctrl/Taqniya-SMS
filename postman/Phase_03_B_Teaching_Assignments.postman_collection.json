      "name": "1. إدارة كشوفات وإسناد التدريس (Teaching Assignments)",
      "description": "مسارات استعراض كشوفات التوزيع بالصفوف والشعب، واستعراض نصاب المعلم وتكليفه وتعديل الإسناد أو إلغاؤه وفق قيود الحماية.",
      "item": [
        {
          "name": "1.1 استعراض وبحث توزيع الكادر التعليمي على المواد والشعب (List Teaching Assignments)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/teaching-assignments?search=&academic_year_id=&class_id=&class_section_id=&teacher_id=&subject_id=&page=1&per_page=15",
            "description": "استرجاع خريطة توزيع الكادر التعليمي على المواد والشعب بالعام الدراسي مجمعة هرمياً لكل صف وشعبة (classes -> sections -> assignments) بدون تكرار للبيانات مع دعم التصفية والترقيم القياسي.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - نجاح جلب التوزيع الأكاديمي\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response has valid teaching assignments hierarchical structure\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an('object');",
                  "    pm.expect(jsonData.data.classes).to.be.an('array');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.classes && jsonData.data.classes.length > 0) {",
                  "    var firstClass = jsonData.data.classes[0];",
                  "    if (firstClass.sections && firstClass.sections.length > 0) {",
                  "        var firstSection = firstClass.sections[0];",
                  "        if (firstSection.assignments && firstSection.assignments.length > 0) {",
                  "            pm.environment.set(\"teachingAssignmentId\", String(firstSection.assignments[0].id));",
                  "            console.log(\"✅ تم استخراج teachingAssignmentId للاختبار:\", firstSection.assignments[0].id);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
