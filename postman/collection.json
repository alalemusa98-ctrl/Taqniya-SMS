{
  "info": {
    "name": "Phase 01: الهوية والمصادقة والتدقيق (Authentication, Identity & Audit)",
    "description": "توثيق شامل ومكتمل لجميع مسارات المرحلة الأولى (10 مسارات) وفق العقد المعماري الرسمي `MD/phases/phase_01_auth_identity/routes.md` وقواعد إطار عمل تقنية (Taqniya Framework).\n\nالمجموعات المشمولة:\n1. المصادقة وإدارة الجلسات (auth)\n2. إدارة حسابات المستخدمين (users)\n3. سجلات التدقيق الأمني والحركات (audit_logs)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. المصادقة وإدارة الجلسات (Authentication & Sessions)",
      "description": "مسارات تسجيل الدخول، استرجاع الملف الشخصي، تسجيل الخروج، وتغيير كلمة المرور.",
      "item": [
        {
          "name": "استرجاع بيانات الملف الشخصي والجلسة النشطة (Get Profile / Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": "استرجاع بيانات الحساب وصلاحيات المستخدم الحالي بناءً على التوكن الممرر في ترويسة الطلب."
          }
        },
        {
          "name": "تسجيل الخروج وإبطال التوكن (Logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "description": "إبطال جلسة العمل الحالية وحذف التوكن المستخدم من جدول التوكنات بقاعدة البيانات."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.environment.set(\"authToken\", \"\");",
                  "    console.log(\"✅ تم تفريغ authToken من متغيرات البيئة بعد تسجيل الخروج بنجاح.\");",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "تسجيل الدخول الموحد بالرمز المؤسسي (Login)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "تسجيل الدخول الموحد لكافة مستخدمي المنظومة (مدير، معلم، طالب، ولي أمر) بالرمز المؤسسي وكلمة المرور.\n\n* ملاحظة: يخضع لحماية التخمين Rate Limiter بحد أقصى 5 طلبات في الدقيقة.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_code\": \"ADM-1001\",\n  \"password\": \"SecretPassword@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Login successful and token returned\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.token).to.be.a('string');",
                  "    });",
                  "    ",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.environment.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"✅ تم حفظ authToken تلقائياً في متغيرات البيئة.\");",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "تغيير كلمة المرور الذاتي للمستخدم (Change Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/change-password",
            "description": "تغيير كلمة المرور الخاصة بالمستخدم المسجل حالياً، مع التحقق الإجباري من كلمة المرور السابقة وتطابق التأكيد.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_password\": \"SecretPassword@123\",\n  \"new_password\": \"SecretPassword@123\",\n  \"new_password_confirmation\": \"NewSecretPassword@2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "2. إدارة حسابات المستخدمين (Users Management - Admin Only)",
      "description": "مسارات إدارة ومراقبة حسابات المستخدمين بالكامل (خاص بمدير النظام Admin حصراً).",
      "item": [
        {
          "name": "إعادة تعيين كلمة المرور إدارياً (Admin Reset Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/{{targetUserId}}/reset-password",
            "description": "إعادة تعيين كلمة المرور لمستخدم بواسطة الإدارة. يقوم النظام تلقائياً بإلغاء كافة الجلسات السابقة للمستخدم لإجباره على الدخول بالكلمة الجديدة وتوثيق العملية في سجل التدقيق.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_password\": \"TempPass#2026!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "استعراض وتصفية شجرة حسابات المستخدمين (List Users Tree)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users?role_type=teacher&is_active=1&page=1&per_page=15&sort_by=created_at&sort_order=desc",
            "description": "استعراض قائمة حسابات المستخدمين في شجرة هرمية مع إحصائيات الأدوار والترقيم والفرز."
          }
        },
        {
          "name": "تفعيل أو إيقاف حساب المستخدم (Update User Status)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/{{targetUserId}}/status",
            "description": "تعديل حالة الحساب إلى مفعل (1) أو معطل (0). عند التعطيل يتم إبطال وشطب كافة جلسات وتوكنات المستخدم فورياً وتوثيق سبب الإجراء في سجل التدقيق.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": 1,\n  \"reason\": \"تعليق مؤقت للحساب لمراجعة الصلاحيات الإدارية\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "عرض تفاصيل حساب مستخدم محدد (Get User By ID)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/users/{{targetUserId}}",
            "description": "استرجاع بيانات تفصيلية لحساب محدد بالمعرف الرقمي (ID)."
          }
        }
      ]
    },
    {
      "name": "3. سجلات التدقيق الأمني (Audit Logs - Admin Only)",
      "description": "مسارات استعراض وتتبع العمليات الحساسة ومقارنة التغييرات (خاص بمدير النظام Admin حصراً).",
      "item": [
        {
          "name": "استعراض وتصفية سجلات التدقيق (List Audit Logs)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/audit-logs?page=1&per_page=15&date_from=2026-01-01&date_to=2026-12-31&sort_by=created_at&sort_order=desc",
            "description": "استرجاع قائمة سجلات التدقيق الأمني مع دعم التصفية المتقدمة حسب التاريخ، نوع الإجراء، الكيان المتأثر، والمستخدم المنفذ."
          }
        },
        {
          "name": "عرض تفاصيل حركة تدقيق ومقارنة الفروقات (Get Audit Log By ID)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/audit-logs/{{targetAuditLogId}}",
            "description": "استرجاع تفاصيل سجل تدقيق محدد متضمناً القيم السابقة (old_values) والقيم الجديدة (new_values) وعنوان الـ IP وبيانات العميل."
          }
        }
      ]
    }
  ]
}