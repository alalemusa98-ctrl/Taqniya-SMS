                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Teacher created with valid atomic user code TCH-XXXX\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.id).to.be.a('number');",
                  "        pm.expect(jsonData.data.user_code).to.match(/^TCH-\\d+$/);",
                  "    });",
                  "",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.environment.set(\"createdTeacherId\", String(jsonData.data.id));",
                  "        console.log(\"✅ تم حفظ createdTeacherId بنجاح:\", jsonData.data.id);",
                  "    }",
                  "} else if (pm.response.code === 409) {",
                  "    pm.test(\"Conflict detected on phone number duplicate\", function () {",
                  "        pm.expect(jsonData.success).to.eql(false);",
                  "    });",
                  "}"
