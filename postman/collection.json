            "url": "{{baseUrl}}/academic/classes",
            "description": "إضافة صف دراسي جديد وتحديد تبعيته للمرحلة التعليمية والترتيب الرقمي للترحيل (grade_level) مع حفظ المعرف `classId`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stage_id\": {{stageId}},\n  \"name\": \"الصف العاشر التأسيسي\",\n  \"grade_level\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 - تم إنشاء الصف وتسكينه بالمرحلة بنجاح\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Created class response contains valid data and ID\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.id).to.be.a('number');",
                  "        pm.expect(jsonData.data.grade_level).to.eql(10);",
                  "    });",
                  "",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.environment.set(\"classId\", String(jsonData.data.id));",
                  "        console.log(\"✅ تم حفظ classId بنجاح:\", jsonData.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
