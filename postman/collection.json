{
  "info": {
    "name": "Phase 02-B: الصفوف والشعب والمواد (Classes, Sections & Subjects)",
    "description": "توثيق واختبارات شاملة ومكتملة لجميع مسارات المرحلة 02-B (12 مساراً) وفق العقد المعماري الرسمي `MD/phases/phase_02_academic_structure_b/routes.md` وقواعد إطار عمل تقنية (Taqniya Framework).\n\nالمجموعات المشمولة:\n0. المصادقة وإعداد الجلسة (auth)\n1. إدارة الصفوف وتحديد تبعيتها للمراحل (classes)\n2. إدارة بنك الشعب العامة (sections)\n3. إدارة بنك المواد الدراسية العامة (subjects)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. المصادقة وإعداد الجلسة (Authentication & Setup)",
      "description": "تسجيل دخول مدير النظام للحصول على توكن الصلاحية وتخزينه تلقائياً في authToken لتشغيل الاختبارات.",
      "item": [
        {
          "name": "تسجيل الدخول كمدير النظام (Login as Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "تسجيل دخول مدير النظام والحصول على التوكن وحفظه في متغير البيئة `authToken` لتمريره في جميع مسارات المرحلة 02-B.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_code\": \"{{adminUserCode}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - تم تسجيل الدخول بنجاح\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Login response contains valid bearer token\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.token).to.be.a('string');",
                  "    });",
                  "    ",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.environment.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"✅ تم حفظ authToken بنجاح لاختبارات المرحلة 02-B.\");",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. إدارة الصفوف وتحديد تبعيتها للمراحل (Classes)",
      "description": "مسارات إدارة الصفوف الدراسية وتسكينها بالمراحل التعليمية وضبط المستوى الأكاديمي الرقمي (استعراض، إنشاء، تعديل، وحذف).",
      "item": [
        {
          "name": "1.1 عرض وبحث قائمة الصفوف الدراسية (List Classes)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/classes?search=&stage_id=&grade_level=&sort_by=grade_level&sort_order=asc&page=1&per_page=15",
            "description": "استرجاع قائمة الصفوف الدراسية المضافة بالمنظومة مع دعم البحث النصي والتصفية بالمرحلة التعليمية والمستوى الرقمي والترتيب والترقيم.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - نجاح جلب قائمة الصفوف الدراسية\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response has valid academic classes schema\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.meta).to.be.an('object');",
                  "    pm.expect(jsonData.meta.current_page).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 إنشاء صف دراسي وتسكينه بمرحلة (Create Class)",
          "request": {
            "method": "POST",
            "header": [
