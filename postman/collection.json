              ],
              "body": "{\n  \"success\": true,\n  \"message\": \"تم تسجيل الدخول بنجاح.\",\n  \"data\": {\n    \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n    \"user\": {\n      \"id\": 1,\n      \"user_code\": \"ADM-1001\",\n      \"role\": \"admin\",\n      \"full_name\": \"مدير النظام العام\"\n    }\n  }\n}"
            }
