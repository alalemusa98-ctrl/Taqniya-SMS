{
  "info": {
    "name": "Phase 03-A: إدارة ملفات الكادر التعليمي (Teachers Profiles Registry)",
    "description": "توثيق واختبارات شاملة ومكتملة لجميع مسارات المرحلة 03-A (5 مسارات) وفق العقد المعماري الرسمي `MD/phases/phase_03_teachers_assignments_a/routes.md` وقواعد إطار عمل تقنية (Taqniya Framework).\n\nالمجموعات المشمولة:\n0. المصادقة وإعداد الجلسة (Authentication & Setup)\n1. إدارة سجل وملفات المعلمين (Teachers Profiles Registry)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. المصادقة وإعداد الجلسة (Authentication & Setup)",
      "description": "تسجيل دخول مدير النظام لتهيئة الجلسة واستخراج التوكن (authToken) لاستخدامه في اختبار وتوثيق مسارات ملفات الكادر التعليمي.",
      "item": [
        {
          "name": "تسجيل الدخول كمدير النظام (Login as Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "تسجيل دخول مدير النظام والحصول على التوكن وحفظه في متغير البيئة `authToken` لتمريره في جميع مسارات المرحلة 03-A.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_code\": \"{{adminUserCode}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - تم تسجيل الدخول بنجاح\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Login response contains valid bearer token\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.token).to.be.a('string');",
                  "    });",
                  "    ",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.environment.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"✅ تم حفظ authToken بنجاح لاختبارات المرحلة 03-A.\");",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK - تم تسجيل الدخول بنجاح",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json",
                    "type": "text"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json",
                    "type": "text"
                  }
                ],
                "url": "{{baseUrl}}/auth/login",
                "description": "تسجيل دخول مدير النظام والحصول على التوكن وحفظه في متغير البيئة `authToken` لتمريره في جميع مسارات المرحلة 03-A.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"user_code\": \"{{adminUserCode}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
