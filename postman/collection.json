                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.name).to.eql(\"تقنية المعلومات والذكاء الاصطناعي (محدثة)\");",
                  "    pm.expect(jsonData.data.code).to.eql(\"IT-AI-ADV\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 حذف مادة عامة غير مسندة (Delete Subject)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/academic/subjects/{{subjectId}}",
            "description": "حذف مادة عامة غير مسندة في مقررات صفوف دراسية بالمعرف `{{subjectId}}`.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
