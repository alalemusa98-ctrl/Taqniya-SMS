    {
      "name": "1. إدارة سجل وملفات المعلمين (Teachers Profiles Registry)",
      "description": "مسارات استعراض وبحث وتفاصيل وإنشاء وتعديل وحذف ملفات المعلمين وتوليد الحسابات الموحدة.",
      "item": [
        {
          "name": "1.1 استعراض وبحث قائمة المعلمين (List Teachers)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/teachers?search=&specialization=&is_active=&sort_by=id&sort_order=desc&page=1&per_page=15",
            "description": "استرجاع قائمة معلمي المدرسة مع دعم البحث النصي بالاسم أو الرمز الموحد user_code والتصفية بالتخصص وحالة الحساب والترقيم القياسي.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - نجاح جلب قائمة المعلمين\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response has valid teachers list schema\", function () {",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    pm.expect(jsonData.meta).to.be.an('object');",
                  "    pm.expect(jsonData.meta.current_page).to.be.a('number');",
                  "});",
                  "",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.environment.set(\"teacherId\", String(jsonData.data[0].id));",
                  "    console.log(\"✅ تم استخراج معلم للاختبار teacherId:\", jsonData.data[0].id);",
                  "}"
                ]
              }
            }
          ],
