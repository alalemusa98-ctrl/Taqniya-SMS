{
  "info": {
    "name": "Phase 05-B: جدول الحصص الأسبوعي وتوزيع الشعب (Timetables Registry)",
    "description": "توثيق واختبارات تكاملية شاملة ومكتملة لجميع مسارات المرحلة 05-B (7 مسارات معتمدة) لإدارة وتسكين جدول الحصص الأسبوعي وتوزيع الشعب الدراسية وجداول المعلمين، وفق العقد المعماري والشبكي الرسمي `MD/phases/phase_05_timetables_b/routes.md` وقواعد إطار عمل تقنية (Taqniya Framework).\n\nالمجموعات المشمولة:\n0. المصادقة وإعداد الجلسة (Authentication & Setup)\n1. إدارة وتسكين الجدول الأسبوعي للحصص (Weekly Timetables Registry)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. المصادقة وإعداد الجلسة (Authentication & Setup)",
      "description": "تهيئة جلسة الاختبار وتسجيل الدخول كمدير النظام لاستخراج التوكن وحفظه في متغير البيئة.",
      "item": [
        {
          "name": "تسجيل الدخول كمدير النظام (Login as Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "تسجيل دخول مدير النظام والحصول على التوكن وحفظه في متغير البيئة `authToken` لتمريره في جميع مسارات المرحلة 05-B.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_code\": \"{{adminUserCode}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - تم تسجيل الدخول بنجاح\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.test(\"Login response contains valid bearer token\", function () {",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.data.token).to.be.a('string');",
                  "    });",
                  "    ",
                  "    if (jsonData.data && jsonData.data.token) {",
                  "        pm.environment.set(\"authToken\", jsonData.data.token);",
                  "        console.log(\"✅ تم حفظ authToken بنجاح لاختبارات المرحلة 05-B.\");",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK - تم تسجيل الدخول بنجاح",
              "originalRequest": {
