          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/timetables/structure?academic_year_id={{academicYearId}}",
            "description": "استرجاع هيكلية المراحل والصفوف والشعب الدراسية التابعة للعام الأكاديمي، لعرض قوائم التنقل واختيار الشعب لتسكين الجداول وفق routes.md.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{authToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 - تم جلب هيكلية الفصول بنجاح\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    pm.test(\"Structure response adheres to SSoT\", function () {",
                  "        pm.expect(res.success).to.eql(true);",
                  "        pm.expect(res.data).to.be.an('array');",
                  "    });",
                  "",
                  "    if (res.data && res.data.length > 0 && res.data[0].sections && res.data[0].sections.length > 0) {",
                  "        pm.environment.set(\"testClassSectionId\", res.data[0].sections[0].class_section_id);",
                  "        console.log(\"✅ تم حفظ testClassSectionId: \" + res.data[0].sections[0].class_section_id);",
                  "    }",
                  "}"
                ]
