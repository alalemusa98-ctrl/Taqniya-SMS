# ==============================================================================
# TAQNIYA SCHOOL MANAGEMENT SYSTEM (.gitignore)
# ==============================================================================

# Dependencies
node_modules/
**/node_modules/
backend/node_modules/
frontend/node_modules/

# Production & Build Outputs
dist/
**/dist/
backend/dist/
frontend/dist/
dist-ssr/
**/dist-ssr/
build/
**/build/
*.tsbuildinfo

# Environment Variables & Secrets
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example
*.local

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
**/coverage/
.nyc_output/

# IDEs & Editor Files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
Thumbs.db

# Temporary & Cache
.temp/
.tmp/
.cache/
.eslintcache
